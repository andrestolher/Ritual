generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(uuid())
  googleId              String?   @unique
  email                 String    @unique
  name                  String
  passwordHash          String?
  emailVerified         Boolean   @default(false)
  verificationTokenHash String?
  verificationExpiresAt DateTime?
  resetTokenHash        String?
  resetExpiresAt        DateTime?
  habits                Habit[]
  createdAt             DateTime  @default(now())
}

model Session {
  sid    String   @id @db.VarChar(255)
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
}

model Habit {
  id                String     @id @default(uuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  type              HabitType
  identityStatement String?
  unit              String?
  goal              Float?
  stackedAfterId    String?
  stackedAfter      Habit?     @relation("HabitStack", fields: [stackedAfterId], references: [id], onDelete: SetNull)
  stackedBefore     Habit[]    @relation("HabitStack")
  logs              HabitLog[]
  createdAt         DateTime   @default(now())

  @@index([userId])
}

enum HabitType {
  BUILD
  AVOID
}

model HabitLog {
  id        String   @id @default(uuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  completed Boolean
  value     Float?
  notes     String?

  @@unique([habitId, date])
}
